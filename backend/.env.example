PORT=3001
# HOST=0.0.0.0
# Behind a trusted reverse proxy, set the exact number of proxy hops.
# TRUST_PROXY_HOPS=1
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Only needed by `npm run seed:test`. Never copy this key into frontend/.env.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SECRET_OR_SERVICE_ROLE_KEY
FRONTEND_ORIGIN=http://127.0.0.1:5173
# Production: serve the built React app from Express.
NODE_ENV=development
