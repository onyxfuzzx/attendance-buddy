{
  "name": "attendance-buddy",
  "version": "1.0.0",
  "description": "Open-source QR and location-verified attendance for every team.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/onyxfuzzx/attendance-buddy.git"
  },
  "homepage": "https://onyxfuzzx.github.io/attendance-buddy/",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "test": "npm run test -w backend",
    "test:ui": "playwright test",
    "supabase:check": "node scripts/check-supabase.mjs",
    "seed:test": "node scripts/seed-supabase.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "dev:website": "vite website --host 127.0.0.1 --port 4174",
    "preview:pages": "vite preview --outDir dist/pages --base /attendance-buddy/ --host 127.0.0.1 --port 4174",
    "test:pages": "playwright test --config playwright.pages.config.ts",
    "start": "npm run start -w backend"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "concurrently": "^9.2.1",
    "prettier": "^3.10.1"
  }
}
